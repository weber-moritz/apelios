<mxfile host="65bd71144e">
    <diagram id="c3-component" name="C3 Component Diagram">
        <mxGraphModel dx="1096" dy="687" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="G58tR8-7LvjBWgE-BqXS-80" value="Container: Python Application Runtime (asyncio)" style="swimlane;whiteSpace=wrap;html=1;dashed=1;startSize=23;fillColor=none;strokeColor=#444444;fontColor=#000000;fontStyle=1;rounded=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="20" y="20" width="760" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="G58tR8-7LvjBWgE-BqXS-81" value="&lt;h2 style=&quot;margin:0;font-size:14px;&quot;&gt;Main Orchestrator&lt;/h2&gt;&lt;p style=&quot;margin:0;font-size:11px;&quot;&gt;[Component: Python]&lt;br&gt;&lt;br&gt;System micro-kernel. Starts Broker server, manages component lifecycles, and drives the 60Hz tick() loop.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#000000;strokeColor=#0b4884;strokeWidth=2;spacing=10;verticalAlign=top;" vertex="1" parent="G58tR8-7LvjBWgE-BqXS-80">
                    <mxGeometry x="50" y="60" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="G58tR8-7LvjBWgE-BqXS-82" value="&lt;h2 style=&quot;margin:0;font-size:14px;&quot;&gt;Input&lt;/h2&gt;&lt;p style=&quot;margin:0;font-size:11px;&quot;&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Stateless edge modules. Normalizes hardware inputs into absolute, delta, or rate intents.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#000000;strokeColor=#0b4884;strokeWidth=2;spacing=10;verticalAlign=top;" vertex="1" parent="G58tR8-7LvjBWgE-BqXS-80">
                    <mxGeometry x="480" y="60" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="G58tR8-7LvjBWgE-BqXS-83" value="&lt;h2 style=&quot;margin:0;font-size:14px;&quot;&gt;Router&lt;/h2&gt;&lt;p style=&quot;margin:0;font-size:11px;&quot;&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Central mapping component. Uses an injected BrokerClient to route incoming inputs to target outputs.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#000000;strokeColor=#0b4884;strokeWidth=2;spacing=10;verticalAlign=top;" vertex="1" parent="G58tR8-7LvjBWgE-BqXS-80">
                    <mxGeometry x="480" y="240" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="G58tR8-7LvjBWgE-BqXS-84" value="&lt;h2 style=&quot;margin:0;font-size:14px;&quot;&gt;Fixture&amp;nbsp;&lt;/h2&gt;&lt;p style=&quot;margin:0;font-size:11px;&quot;&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Maintains state across frames. Resolves targets into DMX addresses based on patch definitions.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#000000;strokeColor=#0b4884;strokeWidth=2;spacing=10;verticalAlign=top;" vertex="1" parent="G58tR8-7LvjBWgE-BqXS-80">
                    <mxGeometry x="480" y="420" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="G58tR8-7LvjBWgE-BqXS-85" value="&lt;h2 style=&quot;margin:0;font-size:14px;&quot;&gt;Output&lt;/h2&gt;&lt;p style=&quot;margin:0;font-size:11px;&quot;&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Protocol adapter layer. Translates the internal shared DMX state into physical Art-Net/sACN network packets.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#000000;strokeColor=#0b4884;strokeWidth=2;spacing=10;verticalAlign=top;" vertex="1" parent="G58tR8-7LvjBWgE-BqXS-80">
                    <mxGeometry x="480" y="600" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="G58tR8-7LvjBWgE-BqXS-86" value="&lt;h2 style=&quot;margin:0;font-size:14px;&quot;&gt;Broker&lt;/h2&gt;&lt;p style=&quot;margin:0;font-size:11px;&quot;&gt;[Component: Python]&lt;br&gt;&lt;br&gt;NATS wrapper and abstraction layer for pub/sub communication between layers.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D7BDE2;fontColor=#000000;strokeColor=#884EA0;strokeWidth=2;spacing=10;verticalAlign=top;" vertex="1" parent="G58tR8-7LvjBWgE-BqXS-80">
                    <mxGeometry x="50" y="380" width="240" height="140" as="geometry"/>
                </mxCell>
