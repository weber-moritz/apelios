                <mxCell id="78Ld1IJF264JJrj9MNvy-234" value="[In-Scope] logic Module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;color:#ffffff;fontSize=9;strokeColor=#66BB6A;" parent="78Ld1IJF264JJrj9MNvy-229" vertex="1">
